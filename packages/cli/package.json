{
  "name": "codebase-atlas",
  "version": "2.0.0",
  "description": "Atlas — scan a frontend codebase and auto-discover, analyze, and document every reusable asset (components, hooks, utils, contexts, stores, routes) using AST semantics — Storybook + Compodoc + Madge + auto-generated docs for modern frontends.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yash-Sakre/atlas.git",
    "directory": "packages/cli"
  },
  "homepage": "https://yash-sakre.github.io/atlas/",
  "bugs": {
    "url": "https://github.com/Yash-Sakre/atlas/issues"
  },
  "type": "commonjs",
  "bin": {
    "atlas": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "dashboard"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "analyze": "tsx src/index.ts analyze",
    "serve": "tsx src/index.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build --prefix ../..",
    "prepack": "node scripts/pack-assets.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "nextjs",
    "vite",
    "typescript",
    "documentation",
    "ast",
    "ts-morph",
    "dependency-graph",
    "dead-code",
    "codebase",
    "storybook",
    "compodoc",
    "madge"
  ],
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.2",
    "fuse.js": "^7.5.0",
    "picocolors": "^1.0.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@codebase-atlas/schema": "*",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
